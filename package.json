{
  "name": "exam-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run build && vitest run && playwright test && npm run test:sw-upgrade",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:sw-upgrade": "node scripts/sw-upgrade.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
